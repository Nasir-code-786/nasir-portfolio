# EmailJS — https://www.emailjs.com
# Copy this file to `.env` and fill in your values.
#
# Setup:
# 1. Email Services → connect Gmail (nasir.mehsud.work@gmail.com)
# 2. Email Templates → paste HTML from emailjs/contact-template.html
#    Subject: New portfolio message from {{name}}
#    Reply To: {{email}}
# 3. Copy Public Key, Service ID, and Template ID below
# 4. Vercel: add the same 3 variables in Project Settings → Environment Variables

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
